{
  "name": "facility-management-backend",
  "version": "1.0.0",
  "description": "Facility Service Management & Work Tracking Platform — REST API backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:memory": "cross-env USE_MEMORY_DB=true nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "seed:demo": "node src/seedDemo.js",
    "seed:products": "node src/seedProducts.js",
    "create:client-user": "node src/createClientUser.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "keywords": [
    "facility-management",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14"
  }
}
