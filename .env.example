# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
# Time zone used for calendar days (attendance, daily counts)
APP_TIMEZONE=Asia/Kolkata
# Background sweep interval in minutes (SLA/overdue alerts, preventive maintenance); 0 disables
SCHEDULER_INTERVAL_MINUTES=5

# Database
# Leave MONGODB_URI pointing at your own MongoDB (local install or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/facility_management
# Set to "true" to boot an in-memory MongoDB instead (no install needed, data is not persisted).
USE_MEMORY_DB=false

# Auth
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Bootstrap admin (used by `npm run seed`)
SEED_ENTERPRISE_NAME=TeamGenix Facility Services
SEED_ADMIN_NAME=Sayan Pal
SEED_ADMIN_EMAIL=admin@teamgenix.in
SEED_ADMIN_PASSWORD=Admin@12345

# Outbound messages (OTP, temporary passwords). "console" only logs them (dev).
APP_NAME=TeamGenix Facility Services
EMAIL_DRIVER=console          # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@teamgenix.in
SMS_DRIVER=console            # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=+91

# Push notifications (Firebase Cloud Messaging) — service account from
# Firebase console → Project settings → Service accounts. Leave empty to only log pushes.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Public base URL of this API (used to build links to locally-stored files)
PUBLIC_BASE_URL=

# File uploads — STORAGE_DRIVER=local writes to UPLOAD_DIR (dev);
# STORAGE_DRIVER=s3 uses AWS S3 or Cloudflare R2 (see src/services/storage.service.js)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL files are served from, e.g. https://media.example.com or the bucket's r2.dev URL
S3_PUBLIC_URL=
